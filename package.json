export default function AuthPage() {
  const [tab, setTab] = useState<"login" | "register">("login");
  const searchParams = useSearchParams();
  const callbackUrl = searchParams.get("callbackUrl") || "/client";
  const error = searchParams.get("error");

  return (
    <div className="min-h-[80vh] flex flex-col items-center justify-center px-6 py-12">
      <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="text-center mb-8">
        <h1 className="font-display text-3xl font-extrabold gradient-text mb-2">Client Area</h1>
        <p className="text-nv-text-muted">Access your purchases, manage licenses, and get support.</p>
      </motion.div>

      <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}
        className="w-full max-w-[420px] bg-nv-card border border-nv-border rounded-[20px] p-8 relative overflow-hidden">
        <div className="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-nv-pink to-nv-purple" />

        {error && (
          <div className="mb-4 p-3 rounded-xl bg-nv-danger/15 border border-nv-danger/30 text-nv-danger text-sm">
            Authentication failed. Please try again.
          </div>
        )}

        <div className="flex gap-2 mb-8 bg-nv-dark rounded-xl p-1">
          <button onClick={() => setTab("login")}
            className={`flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all ${
              tab === "login" ? "bg-gradient-to-r from-nv-pink to-nv-purple text-white shadow-[0_4px_15px_rgba(255,107,157,0.3)]" : "text-nv-text-muted"
            }`}>Login</button>
          <button onClick={() => setTab("register")}
            className={`flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all ${
              tab === "register" ? "bg-gradient-to-r from-nv-pink to-nv-purple text-white shadow-[0_4px_15px_rgba(255,107,157,0.3)]" : "text-nv-text-muted"
            }`}>Register</button>
        </div>

        {tab === "login" ? (
          <form className="space-y-4" onSubmit={(e) => e.preventDefault()}>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Email Address</label>
              <div className="relative">
                <Mail className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="email" placeholder="you@example.com" className="input-field pl-10" />
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Password</label>
              <div className="relative">
                <Lock className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="password" placeholder="••••••••" className="input-field pl-10" />
              </div>
            </div>
            <button className="btn-primary w-full flex items-center justify-center gap-2">Sign In <ArrowRight className="w-4 h-4" /></button>
            <div className="relative my-6">
              <div className="absolute inset-0 flex items-center"><div className="w-full h-px bg-nv-border" /></div>
              <div className="relative flex justify-center"><span className="px-4 bg-nv-card text-nv-text-muted text-xs">or</span></div>
            </div>
            <button onClick={() => signIn("discord", { callbackUrl })}
              className="w-full py-3 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold flex items-center justify-center gap-2 transition-all duration-300 hover:-translate-y-0.5">
              <DiscordIcon className="w-5 h-5" /> Login with Discord
            </button>
            <p className="text-center text-sm text-nv-text-muted mt-4">
              <button className="text-nv-pink hover:underline">Forgot Password?</button>
            </p>
          </form>
        ) : (
          <form className="space-y-4" onSubmit={(e) => e.preventDefault()}>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Username</label>
              <div className="relative">
                <User className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="text" placeholder="YourUsername" className="input-field pl-10" />
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Email Address</label>
              <div className="relative">
                <Mail className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="email" placeholder="you@example.com" className="input-field pl-10" />
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Password</label>
              <div className="relative">
                <Lock className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="password" placeholder="••••••••" className="input-field pl-10" />
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-nv-text-secondary mb-2">Confirm Password</label>
              <div className="relative">
                <Lock className="absolute left-3 top-3 w-5 h-5 text-nv-text-muted" />
                <input type="password" placeholder="••••••••" className="input-field pl-10" />
              </div>
            </div>
            <button className="btn-primary w-full flex items-center justify-center gap-2">Create Account <ArrowRight className="w-4 h-4" /></button>
            <div className="relative my-6">
              <div className="absolute inset-0 flex items-center"><div className="w-full h-px bg-nv-border" /></div>
              <div className="relative flex justify-center"><span className="px-4 bg-nv-card text-nv-text-muted text-xs">or</span></div>
            </div>
            <button onClick={() => signIn("discord", { callbackUrl })}
              className="w-full py-3 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold flex items-center justify-center gap-2 transition-all duration-300 hover:-translate-y-0.5">
              <DiscordIcon className="w-5 h-5" /> Register with Discord
            </button>
            <p className="text-center text-xs text-nv-text-muted mt-4">
              By registering, you agree to our <button className="text-nv-pink hover:underline">Terms</button> and <button className="text-nv-pink hover:underline">Privacy Policy</button>.
            </p>
          </form>
        )}
      </motion.div>
    </div>
  );
}